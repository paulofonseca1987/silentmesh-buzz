# Silent Mesh single-host deployment — copy to .env and fill in.
# All secrets are generated locally and never leave this machine.

# VPN interface IP the relay binds to (Tailscale/WireGuard address of this
# host). NEVER set this to 0.0.0.0 — D11: the workspace server stays dark.
SM_VPN_BIND_ADDR=

# Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BUZZ_S3_ACCESS_KEY=
BUZZ_S3_SECRET_KEY=

# First boot only: set true so the relay runs migrations, then set back to
# false (or use `buzz-admin migrate` explicitly per deploy/compose/README.md).
BUZZ_AUTO_MIGRATE=false

# ── Agent harness (buzz-acp) — supervised by default ─────────────────────────
# Export these in the environment of every buzz-acp harness you run against
# this relay. Silent Mesh flips the upstream default: agent tool calls are
# gated through human approval (kind:46010 in the channel; decide with
# `buzz approvals grant/deny`). full-access is deliberately NOT in the
# allowed set — loosening it is an explicit operator decision here.
BUZZ_ACP_RUNTIME_MODE=supervised
BUZZ_ACP_ALLOWED_RUNTIME_MODES=supervised,auto-accept-edits
# Gated modes need the agent to emit permission requests; never bypass.
# (buzz-acp also auto-downgrades bypass when a gated mode is active.)
BUZZ_ACP_PERMISSION_MODE=default
