# Silent Mesh single-host deployment — copy to .env and fill in.
# All secrets are generated locally and never leave this machine.

# VPN interface IP the relay binds to (Tailscale/WireGuard address of this
# host). NEVER set this to 0.0.0.0 — D11: the workspace server stays dark.
SM_VPN_BIND_ADDR=

# Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BUZZ_S3_ACCESS_KEY=
BUZZ_S3_SECRET_KEY=

# First boot only: set true so the relay runs migrations, then set back to
# false (or use `buzz-admin migrate` explicitly per deploy/compose/README.md).
BUZZ_AUTO_MIGRATE=false
