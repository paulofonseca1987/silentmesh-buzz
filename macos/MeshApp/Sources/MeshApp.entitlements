<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  A Secure Enclave key is persisted in the data-protection keychain,
	  and every item there belongs to an access group the app must be
	  entitled to. A signed app with no entitlements has no group at all,
	  which is why enclave key creation fails with -34018 even once the
	  binary carries a team identifier.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)net.silentmesh.MeshApp</string>
	</array>
</dict>
</plist>
